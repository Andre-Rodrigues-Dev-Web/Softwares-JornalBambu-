<section id="social-view" class="tool-view">
    <header>
        <h1>Social Media <span class="badge">Resizer</span></h1>
        <p>Redimensionone imagens para Instagram, Facebook e Stories instantaneamente.</p>
    </header>
    <div class="card card--glass">
        <div class="form-group">
            <label class="form-group__label">Presets de Formato</label>
            <div class="presets-grid">
                <div class="preset-btn active" data-ratio="1:1">
                    <i class="fab fa-instagram"></i>
                    <span>Post (1:1)</span>
                </div>
                <div class="preset-btn" data-ratio="9:16">
                    <i class="fas fa-mobile-alt"></i>
                    <span>Story (9:16)</span>
                </div>
                <div class="preset-btn" data-ratio="4:5">
                    <i class="fab fa-facebook"></i>
                    <span>Vertical (4:5)</span>
                </div>
                <div class="preset-btn" data-ratio="16:9">
                    <i class="fas fa-tv"></i>
                    <span>Capa (16:9)</span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="socialSource" class="form-group__label">Pasta das Imagens</label>
            <div class="form-group__action-wrapper">
                <input type="text" id="socialSource" placeholder="C:\Noticias\Hoje\Fotos" class="field">
                <button id="socialScan" class="btn btn--secondary btn--secondary--small">Validar</button>
            </div>
        </div>

        <button id="socialProcess" class="btn btn--primary" disabled>
            <span class="btn__text">Processar para Social Media</span>
            <div class="btn__spinner"></div>
        </button>
    </div>
</section>